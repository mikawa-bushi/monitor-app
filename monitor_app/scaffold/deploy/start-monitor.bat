@echo off
rem monitor-app start script (generated by "monitor-app deploy windows").
rem Double-click to start. Close this window or press Ctrl+C to stop.
rem install-task.ps1 in this folder registers it to start automatically.
rem Settings: .env in this folder (MONITOR_PORT, MONITOR_HOST, ...).
rem Log: logs\monitor.log in this folder.
rem cmd.exe reads .bat files in the console code page (cp932 on Japanese
rem Windows), so this file is ASCII unless a path needs other characters;
rem then it is UTF-8 and "chcp 65001" below switches the code page first.
rem PYTHONSAFEPATH=1 (Python 3.11+): "python -m" does not import modules from this
rem folder, so a file such as typer.py placed here cannot replace a library.
@CHCP@cd /d "%~dp0"
set PYTHONUTF8=1
set PYTHONSAFEPATH=1
if not exist logs mkdir logs
echo monitor-app is running. Log: "%CD%\logs\monitor.log"
"@PYTHON@" -m monitor_app runserver --import-csv-if-empty@ARGS@ >> logs\monitor.log 2>&1
exit /b %ERRORLEVEL%
