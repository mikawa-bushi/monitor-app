# 環境ごとに変わる設定。このファイルを .env にコピーして編集する。
# 値は config.py ではなくここに置く(特にパスワード)。
# 先頭の # を外した行だけが有効になる。書いていない設定は既定値(# の行に書いた値)。
# 変数名を誤ると黙って無視されるため、編集後は monitor-app check で確かめる。
# 値に $ を含むときは '...' で囲む(Docker Compose も .env を読み、$ を変数とみなすため)。

# === データベース ===========================================================
# SQLite(既定):
MONITOR_DATABASE_URL=sqlite:///instances/database.db
# PostgreSQL の例(高速なドライバ。pip install "monitor-app[postgres]" が必要):
# MONITOR_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/monitor_app
# PostgreSQL の例(追加のインストール不要):
# MONITOR_DATABASE_URL=postgresql+pg8000://user:password@localhost:5432/monitor_app
# MySQL の例:
# MONITOR_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/monitor_app
#
# SQLite のジャーナルモード。wal は読み書きが互いを待たず速い。
# ネットワーク共有(SMB/NFS)・WSL の /mnt/c・Docker Desktop の共有フォルダ上の DB は
# 自動で delete を使う。macOS の共有フォルダは自動では判別しないため delete を指定する。
# MONITOR_SQLITE_JOURNAL_MODE=wal
# SQLite の同期モード。normal は電源断で直近の書き込みが失われ得るが DB は壊れない。
# normal は wal のときだけ使う(wal 以外では SQLite 既定の full)。厳密な永続性が
# 必要なら full。
# MONITOR_SQLITE_SYNCHRONOUS=normal
# SQLite のロック待ちの上限(ミリ秒)。
# MONITOR_SQLITE_BUSY_TIMEOUT_MS=5000
# PostgreSQL / MySQL に接続できるまで起動時に待つ最大秒数(Docker Compose 向け)。0 で待たない。
# MONITOR_DB_WAIT_TIMEOUT=15

# === サーバー ===============================================================
# 127.0.0.1 はこのパソコンからだけ接続できる。LAN に公開するなら 0.0.0.0
# (その場合は下の MONITOR_API_KEY を必ず設定する)。
MONITOR_HOST=127.0.0.1
MONITOR_PORT=9990
# リバースプロキシ配下のサブパスで公開するとき(例: https://server/monitor/)。
# MONITOR_ROOT_PATH=/monitor
# X-Forwarded-* ヘッダを信頼するプロキシの IP(カンマ区切り、* で全て)。
# 未設定なら uvicorn の既定(127.0.0.1 のみ)。
# MONITOR_FORWARDED_ALLOW_IPS=127.0.0.1
# 受け付ける Host ヘッダの名前(カンマ区切り。*.example.com でサブドメイン、* で確かめない)。
# 未設定なら、127.0.0.1 で待ち受けるときに localhost と IP アドレス以外の名前を断る
# (悪意のある Web ページからの DNS リバインディング対策)。リバースプロキシが
# 元の名前のまま転送するなら、その名前を書く。
# MONITOR_ALLOWED_HOSTS=monitor.example.com
# 大きなレスポンス(ビューの JSON・静的ファイル)を gzip 圧縮する。
# MONITOR_COMPRESS_RESPONSES=true
# アクセスログ(1 リクエスト 1 行)を出す。
# MONITOR_ACCESS_LOG=true
# Docker で動かすときのタイムゾーン(monitor-app deploy docker の compose.yaml が使う。
# 書かなければ生成時のパソコンのタイムゾーン): TZ=Asia/Tokyo

# === 認証・セキュリティ =====================================================
# 設定すると書き込み系 API(追加・変更・削除・取り込み)に X-API-Key ヘッダ
# (画面ではログイン)が必須になる。16 文字以上の推測されにくい文字列にする
# (作り方: python -c "import secrets; print(secrets.token_urlsafe(24))")。
# monitor-app deploy は、未設定なら生成したキーを .env に書く。
# MONITOR_API_KEY=<推測されにくい長い文字列>
# 閲覧(読み取り系 API と画面)も API キーで保護する:
# MONITOR_PROTECT_READS=true
# API ドキュメント(/docs・/redoc・/openapi.json)を公開する。false で出さない
# (MONITOR_PROTECT_READS=true なら、公開してもログインが必要)。
# MONITOR_API_DOCS=true
# 別オリジンの Web アプリから API を呼ぶ場合に許可するオリジン(JSON の配列)。
# MONITOR_CORS_ORIGINS=["http://localhost:3000"]

# === CSV の取り込み =========================================================
# CSV を置くフォルダ(起動したフォルダからの相対パス)。
# MONITOR_CSV_DIR=csv
# CSV の文字コード。auto は UTF-8(BOM の有無を問わない)として読み、読めなければ
# MONITOR_CSV_ENCODING_FALLBACK の順に試す(Excel の「CSV」形式の cp932 も読める)。
# 決まっているなら utf-8-sig / cp932 などを指定する。
# MONITOR_CSV_ENCODING=auto
# auto で UTF-8 として読めなかったときに試す文字コード(カンマ区切り)。
# 西欧の Windows で作った CSV(cp1252)は cp932 として読まれて文字化けするため、
# その場合は MONITOR_CSV_ENCODING に cp1252 を指定する(取り込み時の警告に使った
# 文字コードが出る)。
# MONITOR_CSV_ENCODING_FALLBACK=cp932
# csv/ フォルダを監視して、変更された CSV を自動で取り込む(センサ・PLC が更新する場合):
# MONITOR_INGEST_WATCH=true
# 監視の間隔(秒)。
# MONITOR_INGEST_INTERVAL=5
# 自動取り込みのモード。replace(置き換え)/ append(追記された行だけ。時系列向き)。
# MONITOR_INGEST_MODE=replace

# === 表示の高速化(ビューのキャッシュ)=====================================
# ビューの結果を共有キャッシュする時間(ミリ秒)。0 でキャッシュしない。
# MONITOR_VIEW_CACHE_TTL_MS=1000
# データが変わっていない間、キャッシュを使い続ける最大時間(ミリ秒)。
# MONITOR_VIEW_CACHE_MAX_AGE_MS=15000
# キャッシュが使うメモリのおおよその上限(MB)。超えたら使っていない結果から捨てる。
# 0 で上限なし(件数の上限だけ)。メモリの少ない PC(Raspberry Pi など)では小さめに。
# MONITOR_VIEW_CACHE_MAX_MB=256

# === バックアップ・保持期間 =================================================
# 定期バックアップの保存先(SQLite のみ)。設定すると稼働中でも安全にバックアップする。
# 稼働中に DB ファイルを単純にコピーしないこと(WAL のため最新の書き込みが欠ける)。
# MONITOR_BACKUP_DIR=backups
# バックアップの間隔(時間)。0 で定期実行しない。
# MONITOR_BACKUP_INTERVAL_HOURS=24
# 残すバックアップの世代数。
# MONITOR_BACKUP_KEEP=7
# config.py の retention(古い行の削除)を実行する間隔(分)。
# MONITOR_RETENTION_INTERVAL_MINUTES=10

# === アラート通知(config.py の AlertRule の notify で指定したチャネル)====
# Slack / Teams / 汎用の JSON POST:
# MONITOR_WEBHOOK_URL=https://hooks.slack.com/services/XXX
# メール:
# MONITOR_SMTP_HOST=smtp.example.com
# MONITOR_SMTP_PORT=587
# 暗号化方式。starttls(587 番)/ ssl(SMTPS・465 番)/ none(社内の中継サーバーなど)。
# MONITOR_SMTP_SECURITY=starttls
# サーバーの証明書を検証する。社内の CA の証明書なら環境変数 SSL_CERT_FILE で CA を
# 指定する。自己署名の証明書でどうしても検証できないときだけ false にする。
# MONITOR_SMTP_TLS_VERIFY=true
# MONITOR_SMTP_USER=alert@example.com
# MONITOR_SMTP_PASSWORD=xxxxx
# 宛先(カンマ区切りで複数可):
# MONITOR_ALERT_EMAIL_TO=line-lead@example.com
# 送信に失敗したときの再試行回数(間隔は少しずつ伸ばす)。
# MONITOR_NOTIFY_RETRIES=2

# === 監査ログ(変更履歴。/api/audit で閲覧)================================
# MONITOR_AUDIT_ENABLED=true

# === ログ ===================================================================
# ログの詳しさ。DEBUG / INFO / WARNING / ERROR。
# MONITOR_LOG_LEVEL=INFO
# ログの形式。text(人が読む)/ json(ログ収集基盤向け)。
# MONITOR_LOG_FORMAT=text

# === コマンド(monitor-app)の動作 ===========================================
# 次の 2 つは .env に書いても効かない。シェルの環境変数として設定する。
# エラー時に詳しいトレースバックを表示する(monitor-app --debug と同じ):
#   MONITOR_DEBUG=1 monitor-app runserver
# uvicorn から直接起動するときに読む config.py の場所(runserver は --config の値を使う):
#   MONITOR_CONFIG_PATH=config.py uvicorn monitor_app.main:app_factory --factory
